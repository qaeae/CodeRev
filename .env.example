# ⚠️ 这是模板文件，会被提交到公开仓库。
#    请复制为 .env 后再填真实值；不要把真实 key 写进本文件。
#    .env 已在 .gitignore 中，不会被提交。
#
# 只需要一个 OpenAI 兼容的接口即可，DeepSeek / Moonshot / vLLM / Ollama 都行

CODEREV_API_KEY=
CODEREV_MODEL=
CODEREV_BASE_URL=https://api.openai.com/v1

# 可选：审查参数默认值
# CODEREV_MIN_CONFIDENCE=0.6
# CODEREV_MAX_FINDINGS=8
